# ---------------------------------------------------------------------------
# Mini SOC — environment configuration template.
# Copy to .env and edit.  .env is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
MINI_SOC_ENV=development              # development | staging | production
MINI_SOC_DEBUG=false
MINI_SOC_HOST=127.0.0.1
MINI_SOC_PORT=8000
MINI_SOC_LOG_LEVEL=INFO
# MINI_SOC_HOME=C:\ProgramData\MiniSOC   # optional: relocate data/, logs/, config

# --- Database --------------------------------------------------------------
# SQLite (default, zero-config) or PostgreSQL for larger deployments.
MINI_SOC_DATABASE_URL=sqlite+pysqlite:///./data/mini_soc.db
# MINI_SOC_DATABASE_URL=postgresql+psycopg://mini_soc:CHANGE_ME@localhost:5432/mini_soc

# --- Secrets ---------------------------------------------------------------
# REQUIRED in production.  Leave empty in development and Mini SOC will generate
# a random secret once and persist it to data/secrets/jwt.key with 0600 perms.
MINI_SOC_JWT_SECRET=
MINI_SOC_ACCESS_TOKEN_MINUTES=30
MINI_SOC_REFRESH_TOKEN_DAYS=7

# --- Bootstrap administrator (first run only) ------------------------------
# If these are unset, `python -m app.database.seed --create-admin` prompts.
MINI_SOC_ADMIN_USERNAME=admin
MINI_SOC_ADMIN_PASSWORD=               # never hard-code; set per install
MINI_SOC_ADMIN_EMAIL=admin@example.invalid

# --- Collection ------------------------------------------------------------
MINI_SOC_COLLECTOR_NETWORK_ENABLED=true
MINI_SOC_COLLECTOR_INTERFACE=          # empty = auto/primary interface
MINI_SOC_COLLECTOR_BPF_FILTER=tcp or udp or icmp or arp
MINI_SOC_COLLECTOR_SYSLOG_ENABLED=true
MINI_SOC_COLLECTOR_SYSLOG_HOST=0.0.0.0
MINI_SOC_COLLECTOR_SYSLOG_PORT=5514
MINI_SOC_COLLECTOR_SYSTEM_ENABLED=false
MINI_SOC_SIMULATOR_ENABLED=false       # real-time only; set true only on an isolated lab host
MINI_SOC_SIMULATOR_EPS=5               # synthetic events per second

# --- Detection -------------------------------------------------------------
MINI_SOC_RULES_PATH=../detection-rules
MINI_SOC_ANOMALY_ENABLED=true
MINI_SOC_ANOMALY_MODEL=isolation_forest
MINI_SOC_ANOMALY_THRESHOLD=-0.05

# --- Risk bands (configurable severity mapping, 0-100) ---------------------
MINI_SOC_RISK_LOW_MAX=30
MINI_SOC_RISK_MEDIUM_MAX=60
MINI_SOC_RISK_HIGH_MAX=80

# --- API limits ------------------------------------------------------------
MINI_SOC_RATE_LIMIT_PER_MINUTE=240
MINI_SOC_LOGIN_RATE_LIMIT_PER_MINUTE=10
MINI_SOC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MINI_SOC_SECURE_HEADERS=true
MINI_SOC_TRUSTED_HOSTS=localhost,127.0.0.1
